    else if (zombieUsedDefend) {
        if (actionTaken === "Move") {
            console.log(`🛡️ ENEMY BLOCK! The foe fully braced and absorbed your [${chosenMove.name}]! Damage dealt: 0.`);
        } else {
            console.log("🛡️ The enemy defended heavily, but you were busy setting up a tactical option instead of attacking.");
        }
    } 
    else {
        if (actionTaken === "Stunned" || actionTaken === "Strategy" || actionTaken === "Item") {
            if (zombieAction === "Move") {
                console.log(`💥 VULNERABLE! You were unable to defend as the enemy landed a clean blow.`);
                player.hp -= enemy.attack;
                console.log(`You took ${enemy.attack} damage!`);
            } else if (zombieAction === "Stunned" || zombieAction === "Strategy") {
                console.log("💤 Neither side launched an attack. Both are adjusting their layouts.");
            }
        } 
        else if (actionTaken === "Move") {
            if (zombieAction === "Stunned" || zombieAction === "Strategy") {
                console.log(`🔥 STRATEGIC CRITICAL HIT! You caught the enemy wide open during its setup turn!`);
                let damageDealt = Math.floor(chosenMove.power * 1.5 * rngModifier); 
                if (reductionActive) {
                    let penalty = (intelLevel >= 3) ? 0.10 : 0.25;
                    damageDealt = Math.floor(damageDealt * (1 - penalty));
                    reductionActive = false;
                    console.log(`🌀 Stun Aftereffect: Attack power was reduced slightly.`);
                }
                enemy.hp -= damageDealt;
                console.log(`The ${enemy.name} took a punishing ${damageDealt} damage!${rngLabel}`);
            } 
            else if (zombieAction === "Move") {
                if (chosenMove.type === "Neutral") {
                    console.log(`⚔️ Pure Physical Clash! You trade heavy kinetic impacts evenly.`);
                    let damageDealt = Math.floor(chosenMove.power * rngModifier);
                    if (reductionActive) {
                        let penalty = (intelLevel >= 3) ? 0.10 : 0.25;
                        damageDealt = Math.floor(damageDealt * (1 - penalty));
                        reductionActive = false;
                    }
                    enemy.hp -= damageDealt;
                    player.hp -= Math.floor(enemy.attack / 2);
                    console.log(`The ${enemy.name} took ${damageDealt} damage! You took ${Math.floor(enemy.attack / 2)} recoil damage!${rngLabel}`);
                }
                else if (chosenMove.type === zombieMove.type) {
                    if (chosenMove.type === "Fire") console.log("💨 Exploding Fire! Intense heat collides, filling the area with blinding smoke! (No damage)");
                    else if (chosenMove.type === "Water") console.log("💦 Colliding Oceans! Torrents splash together, creating a beautiful wall of mist! (No damage)");
                    else if (chosenMove.type === "Earth") console.log("🪨 Shattered Pillars! Rock crashes into rock, showering the arena with dust! (No damage)");
                } 
                else if (
                    (chosenMove.type === "Fire" && zombieMove.type === "Earth") ||
                    (chosenMove.type === "Water" && zombieMove.type === "Fire") ||
                    (chosenMove.type === "Earth" && zombieMove.type === "Water")
                ) {
                    console.log(`🔥 ELEMENTAL OVERPOWER! Your ${chosenMove.type} tore straight through their ${zombieMove.type}!`);
                    let damageDealt = Math.floor(chosenMove.power * rngModifier);
                    if (reductionActive) {
                        let penalty = (intelLevel >= 3) ? 0.10 : 0.25;
                        damageDealt = Math.floor(damageDealt * (1 - penalty));
                        reductionActive = false;
                    }
                    enemy.hp -= damageDealt;
                    console.log(`The ${enemy.name} took ${damageDealt} damage!${rngLabel}`);
                } 
                else {
                    console.log(`❌ ELEMENTAL COUNTERED! The enemy's ${zombieMove.type} completely engulfed your ${chosenMove.type}!`);
                    let finalDamage = Math.floor(enemy.attack * rngModifier);
                    if (zombieReduction) {
                        finalDamage = Math.floor(finalDamage * 0.75);
                        zombieReduction = false;
                        console.log(`🌀 Enemy Stun Aftereffect: The ${enemy.name}'s attack power was reduced by 25%.`);
                    }
                    player.hp -= finalDamage;
                    console.log(`You took ${finalDamage} damage!${rngLabel}`);
                }
            }
        }
    }

    if (zombieAction !== "Strategy") {
        zombieReduction = false;
    }

    if (scoutDuration > 0) scoutDuration--;
    if (zombieScoutDuration > 0) zombieScoutDuration--;
    if (mirrorDuration > 0) mirrorDuration--;

    if (player.regen && player.hp > 0) {
        if (player.hp < player.maxhp) {
            player.hp += 5;
            if (player.hp > player.maxhp) player.hp = player.maxhp;
            console.log(`✨ Cookie Effect: Regenerated 5 HP! (${player.hp}/${player.maxhp})`);
        }
        if (player.hp === player.maxhp) {
            console.log("💚 Full health reached! Cookie effect finished.");
            player.regen = false;
        }
    }

    if (player.hp <= 0) {
        console.log(`\n💀 GAME OVER! You fell on Stage ${stage}.`);
        console.log(`Final Score: You cleared ${stage - 1} stages!`);
        alive = false;
        break;
    }

    if (enemy.hp <= 0) {
        let earnedXP = 15 + (stage * 5);
        playerXP += earnedXP;
        console.log(`\n🎉 You defeated the ${enemy.name} on Stage ${stage}!`);
        console.log(`✨ Gained +${earnedXP} XP! Total XP: ${playerXP}`);
        
        playerIsStunned = false;
        reductionActive = false;
        scoutDuration = 0;
        zombieStunned = false;
        zombieReduction = false;
        zombieScoutDuration = 0;
        zombieNextFeint = null;
        bossEnraged = false;
        mirrorDuration = 0;

        let randomHpBoost = Math.floor(Math.random() * 4) + 2; 
        dynamicEnemyHpPool += randomHpBoost;
        console.log(`📈 Adaptive Strain: Mutation indexes increased. Future host health pool elevated by +${randomHpBoost} HP.`);

        if (stage === 50 && !endlessMode) {
            console.log("\n🏆 ================= WORLD CLEAR ================= 🏆");
            console.log("Patient Zero has been expunged. The atmosphere returns to equilibrium.");
            console.log("You have saved what remains of humanity.");
            let decision = prompt("Do you want to finish here and win, or enter ENDLESS MODE? (finish/endless): ");
            if (decision === null) decision = "finish";
            decision = decision.trim().toLowerCase();
            
            if (decision === "finish" || decision === "f") {
                console.log(`\nThank you for playing! Final clean run score: Stage 50 reached with ${playerXP} XP.`);
                alive = false;
                break;
            } else {
                endlessMode = true;
                console.log("\n♾️ WARNING: Entering Endless Mode. Difficulty scales infinitely from this point forward.");
            }
        }

        if (stage % 5 === 0) {
            if (currentChapNum === 1) {
                player.hp = player.maxhp;
                console.log("\n⚕️ Shop Auto-Heal: Restored 100% health after clearing Chapter 1.");
            } else if (currentChapNum === 2) {
                player.hp = Math.min(player.maxhp, player.hp + Math.floor(player.maxhp * 0.5));
                console.log("\n⚕️ Shop Auto-Heal: Restored 50% health. The atmosphere is turning hostile.");
            } else {
                console.log("\n⚕️ Shop Auto-Heal: 0% Restored. The plague corrupts local environments completely. No automatic healing allowed.");
            }
            player.regen = false;

            alert("Chapter Wave cleared! Entering safe zone Shop zone...");

            console.log(`\n================ SHOP INTERMISSION ================\nWelcome back to safety. Spend your currency to modify your build parameters.`);
            let shopping = true;
            while (shopping) {
                console.log(`\n--- SHOP MANUAL (XP Balance: ${playerXP}) ---`);
                console.log(`1. Upgrade Intelligence [Level ${intelLevel}] (Cost: 40 XP)`);
                console.log(`2. Buy Cookie [Regen item] (Cost: 15 XP)`);
                console.log(`3. Buy Bandage [Instant 10 HP heal] (Cost: 10 XP)`);
                console.log(`4. Upgrade Max HP (+15 Max HP) (Cost: 25 XP)`);
                console.log(`5. Train Move Damage (+4 power to all moves) (Cost: 30 XP)`);
                console.log(`6. Depart on next Campaign Wave`);
                
                let shopChoice = prompt("Select a shop option number: ");
                if (shopChoice === null) shopChoice = "6";
                let choice = shopChoice.trim().toLowerCase();
                
                if (choice === "1") {
                    if (playerXP >= 40) {
                        playerXP -= 40;
                        intelLevel++;
                        console.log(`🧠 Intelligence upgraded to Level ${intelLevel}!`);
                        if (intelLevel === 2) {
                            player.strategies["1"].desc = "Leaves you vulnerable. Deciphers exact enemy actions flawlessly for 3 full turns instead of 2.";
                            console.log("-> Upgrade Unlocked: Analyze tracking length increased!");
                        } else if (intelLevel === 3) {
                            player.strategies["2"].desc = "Blocks all incoming damage this turn. Stun recovery damage reduction penalty mitigated down to only 10%.";
                            console.log("-> Upgrade Unlocked: Defend stun penalty highly mitigated!");
                        } else if (intelLevel === 4) {
                            player.strategies["4"] = { name: "Counter-Strike", desc: "Completely parries an attacking enemy without receiving next-turn stun penalties." };
                            console.log("-> Upgrade Unlocked: Master Strategy Added: [Counter-Strike] unlocked!");
                        }
                    } else {
                        console.log("Insufficient XP!");
                    }
                } else if (choice === "2") {
                    if (playerXP >= 15) {
                        playerXP -= 15;
                        player.items.push({ name: "Cookie", desc: "Grants 5 HP regeneration every turn until full health." });
                        console.log("🍪 Cookie added to your stash.");
                    } else {
                        console.log("Insufficient XP!");
                    }
                } else if (choice === "3") {
                    if (playerXP >= 10) {
                        playerXP -= 10;
                        player.items.push({ name: "Bandage", desc: "Instantly restores 10 HP." });
                        console.log("🩹 Bandage added to your stash.");
                    } else {
                        console.log("Insufficient XP!");
                    }
                } else if (choice === "4") {
                    if (playerXP >= 25) {
                        playerXP -= 25;
                        player.maxhp += 15;
                        player.hp += 15;
                        console.log(`❤️ Max HP upgrade complete! Current Max HP: ${player.maxhp}`);
                    } else {
                        console.log("Insufficient XP!");
                    }
                } else if (choice === "5") {
                    if (playerXP >= 30) {
                        playerXP -= 30;
                        for (let k in player.moves) {
                            player.moves[k].power += 4;
                        }
                        console.log("⚔️ Combat modules trained! All moves permanent power boosted by +4.");
                    } else {
                        console.log("Insufficient XP!");
                    }
                } else if (choice === "6" || choice === "depart" || choice === "") {
                    shopping = false;
                    console.log("Stepping out of shop safety...");
                }
            }
        }

        stage++;
        enemy = generateEnemy(stage);
        
        if (stage % 5 === 1 && !endlessMode) {
            let nextChapNum = getChapterNumber(stage);
            if (chapters[nextChapNum]) {
                alert(`Preparing transmission... Chapter ${nextChapNum} loaded.`);
                console.log(`\n================ NEW LORE UNLOCKED ================`);
                console.log(chapters[nextChapNum].lore);
                console.log(`===================================================`);
            }
        }
        
        console.log(`\n⚠️ Stage loaded. Engaging target environment.`);
        continue;
    }
}
