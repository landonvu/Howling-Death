function getChapterNumber(stg) {
    if (endlessMode) return 10;
    return Math.floor((stg - 1) / 5) + 1;
}

function generateEnemy(stg) {
    let chapNum = getChapterNumber(stg);
    let chap = chapters[chapNum] || chapters[10];
    
    let isBoss = (stg % 5 === 0);
    let effectiveStage = stg;
    
    if (!endlessMode) {
        if (stg % 5 === 1 && stg > 1) {
            effectiveStage = Math.max(1, stg - 2);
        }
    }
    
    let baseHp = isBoss ? 100 : 40 + (effectiveStage * 12);
    let baseAtk = isBoss ? 16 : 8 + (effectiveStage * 2);
    
    if (chapNum > 1 || endlessMode) {
        let factor = endlessMode ? (stg * 0.15) : ((chapNum - 1) * 0.20);
        baseHp = Math.floor(baseHp * (1 + factor));
        baseAtk = Math.floor(baseAtk * (1 + (factor * 0.75)));
    }
    
    baseHp += dynamicEnemyHpPool;
    
    let name = isBoss ? chap.bossName : chap.gruntName;
    if (endlessMode) name = "[ENDLESS] " + name;
    
    return {
        name: name,
        hp: baseHp,
        maxhp: baseHp,
        attack: baseAtk,
        moves: chap.moves,
        strategies: [
            { name: "Analyze" },
            { name: "Defend" },
            { name: "Attack" }
        ]
    };
}

